<Project>
  <!-- Central package versions (ARCHITECTURE.md §1). -->
  <ItemGroup>
    <!-- Windows App SDK 2.4 (meta package: Base/Foundation/WinUI/InteractiveExperiences/...) -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.AI" Version="2.4.4" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.ML" Version="2.1.74" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />

    <!-- MVVM / DI / Logging -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Serilog" Version="4.3.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageVersion Include="FlaUI.Core" Version="4.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="4.0.0" />
    <!-- FlaUI 4 pins a vulnerable System.Drawing.Common 5.0.2; lift it (NU1904). -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>
</Project>
