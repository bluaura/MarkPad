<ContentDialog
    x:Class="MarkPad.App.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MarkPad 정보"
    CloseButtonText="닫기"
    DefaultButton="Close">
    <StackPanel Spacing="10" MinWidth="420">
        <TextBlock x:Name="VersionText" Style="{ThemeResource BodyStrongTextBlockStyle}" />
        <TextBlock Text="Windows용 WYSIWYG Markdown 뷰어·에디터. 메모장의 가벼움 + Typora의 WYSIWYG 편집 + Word 같은 서식 툴바." TextWrapping="Wrap" />
        <TextBlock x:Name="RuntimeText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <TextBlock Text="단축키" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,6,0,0" />
        <TextBlock TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}">
            Ctrl+N 새 문서 · Ctrl+O 열기 · Ctrl+S 저장 · Ctrl+Shift+S 다른 이름으로 · Ctrl+W 탭 닫기 · Ctrl+Tab 탭 전환 · Ctrl+F/H 찾기·바꾸기 ·
            Ctrl+Shift+O 개요 · Ctrl+Shift+B 파일 사이드바 · Ctrl+Shift+T 툴바 · Ctrl+=/−/0 확대 · Ctrl+Shift+E 내보내기 · Ctrl+P 인쇄 · Ctrl+, 설정 ·
            서식: Ctrl+B/I/E, Ctrl+Shift+X 취소선, Ctrl+1~6 제목, Ctrl+Shift+7/8/9 목록, Ctrl+Shift+Q 인용, Ctrl+Shift+C 코드블록, Ctrl+K 링크, Ctrl+T 표, Ctrl+\ 서식 지우기, F5 날짜
        </TextBlock>
        <TextBlock Text="오픈 소스 구성 요소" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,6,0,0" />
        <TextBlock TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                   Text="Milkdown / Crepe (MIT) · ProseMirror (MIT) · remark / unified (MIT) · CodeMirror (MIT) · KaTeX (MIT) · Mermaid (MIT) · yaml (ISC) · DOMPurify (Apache-2.0 / MPL-2.0) · Windows App SDK / WinUI 3 (MIT) · CommunityToolkit.Mvvm (MIT) · Serilog (Apache-2.0)" />
        <HyperlinkButton x:Name="LogsLink" Content="로그 폴더 열기" Click="OnOpenLogs" Padding="0" />
    </StackPanel>
</ContentDialog>
