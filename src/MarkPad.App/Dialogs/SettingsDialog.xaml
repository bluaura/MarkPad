<ContentDialog
    x:Class="MarkPad.App.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="설정"
    PrimaryButtonText="저장"
    CloseButtonText="취소"
    DefaultButton="Primary">
    <ScrollViewer MaxHeight="560">
        <StackPanel Spacing="14" MinWidth="440" Margin="0,0,12,0">
            <TextBlock Text="모양" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ComboBox x:Name="ThemeBox" Header="테마" MinWidth="200">
                <ComboBoxItem Content="시스템" Tag="system" />
                <ComboBoxItem Content="라이트" Tag="light" />
                <ComboBoxItem Content="다크" Tag="dark" />
            </ComboBox>
            <TextBox x:Name="FontFamilyBox" Header="편집 폰트" PlaceholderText="Segoe UI Variable" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <NumberBox x:Name="FontSizeBox" Header="글꼴 크기 (px)" Minimum="9" Maximum="40" SpinButtonPlacementMode="Compact" SmallChange="1" />
                <NumberBox x:Name="LineHeightBox" Header="줄 간격" Minimum="1" Maximum="3" SpinButtonPlacementMode="Compact" SmallChange="0.1" />
                <NumberBox x:Name="MaxWidthBox" Header="본문 최대 폭 (px)" Minimum="400" Maximum="4000" SpinButtonPlacementMode="Compact" SmallChange="50" />
            </StackPanel>

            <TextBlock Text="이미지" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBox x:Name="ImageFolderBox" Header="이미지 저장 폴더 이름" PlaceholderText="assets" />
            <ToggleSwitch x:Name="AllowRemoteBox" Header="원격(http) 이미지 표시" OnContent="허용" OffContent="차단" />

            <TextBlock Text="저장" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ComboBox x:Name="EolBox" Header="줄바꿈" MinWidth="200">
                <ComboBoxItem Content="원본 유지" Tag="preserve" />
                <ComboBoxItem Content="LF" Tag="lf" />
                <ComboBoxItem Content="CRLF" Tag="crlf" />
            </ComboBox>
            <ToggleSwitch x:Name="TrailingNewlineBox" Header="파일 끝 개행 보장" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch x:Name="AutosaveBox" Header="자동 저장" />
                <NumberBox x:Name="AutosaveIntervalBox" Header="간격 (초)" Minimum="5" Maximum="3600" SpinButtonPlacementMode="Compact" SmallChange="5" />
            </StackPanel>

            <TextBlock Text="Markdown 직렬화 (새로 만드는 블록에만 적용)" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="EmphasisBox" Header="강조 기호">
                    <ComboBoxItem Content="*기울임*" Tag="*" />
                    <ComboBoxItem Content="_기울임_" Tag="_" />
                </ComboBox>
                <ComboBox x:Name="BulletBox" Header="목록 기호">
                    <ComboBoxItem Content="-" Tag="-" />
                    <ComboBoxItem Content="*" Tag="*" />
                    <ComboBoxItem Content="+" Tag="+" />
                </ComboBox>
                <ComboBox x:Name="IndentBox" Header="들여쓰기">
                    <ComboBoxItem Content="2칸" Tag="2" />
                    <ComboBoxItem Content="4칸" Tag="4" />
                </ComboBox>
            </StackPanel>

            <TextBlock Text="확장 (새로 여는 문서부터 적용)" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ToggleSwitch x:Name="HighlightBox" Header="==하이라이트== (기본 OFF)" />
            <ToggleSwitch x:Name="MathBox" Header="수식 ($…$, KaTeX)" />
            <ToggleSwitch x:Name="MermaidBox" Header="Mermaid 다이어그램" />
            <ToggleSwitch x:Name="FrontMatterBox" Header="YAML front matter 블록" />

            <TextBlock x:Name="PathText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
