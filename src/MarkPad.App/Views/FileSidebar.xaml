<UserControl
    x:Class="MarkPad.App.Views.FileSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MarkPad.App.ViewModels">
    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="12,8,8,4">
            <TextBlock x:Uid="SidebarHeader" Text="파일" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Padding="4" Background="Transparent" BorderThickness="0" Click="OnRefreshClick" ToolTipService.ToolTip="새로 고침" AutomationProperties.Name="새로 고침">
                <FontIcon Glyph="&#xE72C;" FontSize="12" />
            </Button>
        </Grid>
        <TextBlock x:Uid="SidebarEmpty" Grid.Row="1" Text="문서를 저장하면 그 폴더가 표시됩니다" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="12,4" TextWrapping="Wrap" Visibility="{x:Bind IsEmpty}" />
        <TreeView Grid.Row="1" x:Name="Tree" AutomationProperties.Name="파일 트리" ItemsSource="{x:Bind ViewModel.Roots, Mode=OneWay}" SelectionMode="None" CanDragItems="False" CanReorderItems="False" ItemInvoked="OnItemInvoked">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileEntry">
                    <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                            <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
