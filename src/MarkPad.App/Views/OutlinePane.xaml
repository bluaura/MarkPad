<UserControl
    x:Class="MarkPad.App.Views.OutlinePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MarkPad.App.ViewModels">
    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="OutlineHeader" Grid.Row="0" Text="개요" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12,10,12,4" />
        <TextBlock x:Uid="OutlineEmpty" Grid.Row="1" Text="제목이 없습니다" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="12,4" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        <ListView Grid.Row="1" AutomationProperties.Name="개요 제목 목록" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="8,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:OutlineEntry">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsActive, Mode=OneWay}" CornerRadius="1" Margin="-6,4" />
                        <TextBlock Text="{x:Bind Text}" Margin="{x:Bind IndentMargin}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="{x:Bind Weight}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
