<UserControl
    x:Class="MarkPad.App.Views.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mru="using:MarkPad.Core.Mru">
    <ScrollViewer>
        <StackPanel MaxWidth="640" Margin="48,56" Spacing="24" HorizontalAlignment="Center">
            <StackPanel Spacing="4">
                <TextBlock Text="MarkPad" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                <TextBlock x:Uid="StartTagline" Text="Markdown 파일을 열면 렌더링된 상태로 바로 편집할 수 있습니다." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{x:Bind ViewModel.NewDocumentCommand}" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                        <TextBlock x:Uid="StartNewLabel" Text="새 문서" />
                        <TextBlock Text="Ctrl+N" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.OpenWithPickerCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock x:Uid="StartOpenLabel" Text="열기" />
                        <TextBlock Text="Ctrl+O" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="StartRecentHeader" Text="최근 파일" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock x:Uid="StartRecentEmpty" Text="아직 연 파일이 없습니다. .md 파일을 이 창에 끌어다 놓아도 됩니다."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind HasNoRecent}" />
                <ListView x:Name="RecentList"
                          AutomationProperties.Name="최근 파일 목록"
                          ItemsSource="{x:Bind ViewModel.RecentFiles, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnRecentClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="mru:RecentFile">
                            <Grid ColumnSpacing="12" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind Directory}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
