{
  "name": "markpad-editor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MarkPad WYSIWYG editor bundle (Milkdown/Crepe) hosted in WebView2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "^1.2.0",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "@codemirror/language-data": "^6.5.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-rehype": "^11.1.1",
    "unist-util-visit": "^5.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12"
  }
